modules = ["nodejs-20", "python-3.12", "web"]

[nix]
channel = "stable-25_05"

[agent]
expertMode = true

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "WORIYA EXPRESS API"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "WORIYA EXPRESS Web"

[[workflows.workflow]]
name = "WORIYA EXPRESS API"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd apps/api && npm run dev"

[[workflows.workflow]]
name = "WORIYA EXPRESS Web"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd apps/web && npm run dev -- --host 0.0.0.0 --port 5000"

[[ports]]
localPort = 4000
externalPort = 3001

[[ports]]
localPort = 5000
externalPort = 80

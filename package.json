{
  "name": "lwebapp",
  "private": true,
  "version": "0.0.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm -w @lwebapp/web run dev",
    "dev:api": "npm -w @lwebapp/api run dev",
    "build": "npm -w @lwebapp/api run build && npm -w @lwebapp/web run build",
    "lint": "npm -w @lwebapp/web run lint"
  },
  "dependencies": {
    "fast-xml-parser": "5.10.1"
  },
  "overrides": {
    "fast-xml-parser": "5.10.1"
  }
}
